#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
source_script="$root/scripts/trackerctl.exs"

if [ -f "$source_script" ]; then
  build_path=${MIX_BUILD_PATH:-"$root/_build/${MIX_ENV:-dev}"}
  set -- "$source_script" "$@"

  for ebin in "$build_path"/lib/*/ebin; do
    if [ -d "$ebin" ]; then
      set -- -pa "$ebin" "$@"
    fi
  done

  exec elixir "$@"
fi

release_script="$root/libexec/trackerctl.exs"
if [ ! -f "$release_script" ]; then
  printf '%s\n' '{"schema":"wtr.cli.v1","error":{"code":"cli_not_installed"}}' >&2
  exit 1
fi

release_vsn=
IFS=' ' read -r _erts_vsn release_vsn < "$root/releases/start_erl.data" || [ -n "$release_vsn" ]
release_elixir="$root/releases/$release_vsn/elixir"

if [ ! -x "$release_elixir" ]; then
  printf '%s\n' '{"schema":"wtr.cli.v1","error":{"code":"erts_not_installed"}}' >&2
  exit 1
fi

export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:+$ELIXIR_ERL_OPTIONS }+fnu"
exec "$release_elixir" \
  --boot "$root/releases/$release_vsn/start_clean" \
  --boot-var RELEASE_LIB "$root/lib" \
  "$release_script" "$@"
