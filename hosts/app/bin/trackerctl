#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
source_script="$root/scripts/trackerctl.exs"

if [ -f "$source_script" ]; then
  build_path=${MIX_BUILD_PATH:-"$root/_build/${MIX_ENV:-dev}"}
  set -- "$source_script" "$@"

  for ebin in "$build_path"/lib/*/ebin; do
    if [ -d "$ebin" ]; then
      set -- -pa "$ebin" "$@"
    fi
  done

  exec elixir "$@"
fi

release_script="$root/libexec/trackerctl.exs"
if [ ! -f "$release_script" ]; then
  printf '%s\n' '{"schema":"wtr.cli.v1","error":{"code":"cli_not_installed"}}' >&2
  exit 1
fi

erl=
for candidate in "$root"/erts-*/bin/erl; do
  if [ -x "$candidate" ]; then
    erl=$candidate
    break
  fi
done

if [ -z "$erl" ]; then
  printf '%s\n' '{"schema":"wtr.cli.v1","error":{"code":"erts_not_installed"}}' >&2
  exit 1
fi

set -- -extra "$@"
set -- -eval 'application:ensure_all_started(elixir), Args = [list_to_binary(Arg) || Arg <- init:get_plain_arguments()], '\''Elixir.System'\'':argv(Args), '\''Elixir.Code'\'':require_file(list_to_binary(os:getenv("WOTEX_TRACKER_CLI_SCRIPT"))).' "$@"
set -- -noshell -noinput "$@"
for ebin in "$root"/lib/*/ebin; do
  if [ -d "$ebin" ]; then
    set -- -pa "$ebin" "$@"
  fi
done

export WOTEX_TRACKER_CLI_SCRIPT="$release_script"
exec "$erl" "$@"
