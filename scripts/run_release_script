#!/bin/sh
set -eu

release=$1
script=$2
shift 2

release_vsn=
IFS=' ' read -r _erts_vsn release_vsn < "$release/releases/start_erl.data" || [ -n "$release_vsn" ]
release_elixir="$release/releases/$release_vsn/elixir"

if [ ! -x "$release_elixir" ]; then
  printf '%s\n' 'bundled ERTS is unavailable' >&2
  exit 1
fi

export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:+$ELIXIR_ERL_OPTIONS }+fnu"
export WOTEX_TRACKER_RELEASE_ROOT=$release
exec "$release_elixir" \
  --boot "$release/releases/$release_vsn/start_clean" \
  --boot-var RELEASE_LIB "$release/lib" \
  "$script" "$@"
